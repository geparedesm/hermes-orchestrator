.DS_Store
.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
# Generated service tokens and passwords (scripts/init-secrets.sh)
secrets/*
!secrets/.gitkeep
# Machine-specific platform overrides
config/local.yaml
.env
compose.override.yaml
config/images.lock.yaml
config/image-cache/

# Secrets Broker v1 file store (never committed)
project-secrets/
config/models.lock.json
# Local recovery snapshots contain runtime data and are not source files.
backups/

# Local preview image references and deployment identity
deploy/preview/runtime.env
deploy/preview/controller.lock
deploy/preview/current.json

.env.pre-update
.env.bak
