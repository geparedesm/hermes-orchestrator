# Copy to .env and adjust. Never commit .env.

# Machine profile from config/: mac-m2-pro or linux
HO_MACHINE_PROFILE=mac-m2-pro

# Absolute host path of the directory holding registered projects.
# Only repositories inside this directory can be registered.
HO_PROJECTS_ROOT_HOST=/Users/CHANGE_ME/HermesProjects

# Image tag for locally built service images.
HO_VERSION=dev

HO_LOG_LEVEL=INFO

# Group ID that owns the Docker socket. Docker Desktop: 0. Linux: getent group docker | cut -d: -f3
HO_DOCKER_GID=0

# Secrets Broker v1 store (outside the projects root): <project>/<environment>/<NAME>, one file per
# secret, mode 0600. Linux: the files must be readable by UID 10003 (agent-manager).
HO_PROJECT_SECRETS_HOST=./project-secrets

# Provider identity used by executions: credential volumes cred-claude-<identity> and
# cred-codex-<identity>, created by `make auth-claude IDENTITY=...` / `make auth-codex IDENTITY=...`.
HO_PROVIDER_IDENTITY=default

# Phase 7: lead READY tasks with the multi-agent orchestrator (Claude, Codex as fallback).
# Off by default: tasks then wait for operator-driven work (ho agent run, ho git ..., ho review ...).
HO_ORCHESTRATION=false

# Service limits (docs/operations.md, "Resources"); defaults suit 8 GB hosts and larger. Example:
# HO_HERMES_MEMORY=1536m
# HO_HERMES_CPUS=1.5

# UI proposal images: activate only after authorizing this exact destination. Off by default.
HO_UI_DESIGN_DELIVERY=false
HO_UI_DESIGN_DELIVER_PLATFORM=
HO_UI_DESIGN_DELIVER_CHAT_ID=
