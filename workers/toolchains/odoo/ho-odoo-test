#!/usr/bin/env bash
# Install an Odoo module from /workspace into a throwaway database and run its tests (docs/design/child-projects.md).
#
#   ho-odoo-test <module>
#
# The repository keeps __manifest__.py at its root, while Odoo finds a module as <addons_path>/<module>: a temporary
# addons directory holds only <module> -> /workspace. The database server is the project's test PostgreSQL service
# (test_environment in .hermes/project.yaml): HO_ODOO_DB_HOST (default postgres), HO_ODOO_DB_USER and
# HO_ODOO_DB_PASSWORD (default odoo, test-only values of that throwaway service).
#
# Browser tests (HttpCase tours): Odoo gives headless Chromium a fixed 10 s to open its DevTools port and otherwise
# SKIPS the test. On a loaded machine (an agent, Odoo and Chromium sharing a 2 GiB worker) a cold start can take
# longer, so Odoo runs here with that wait raised to HO_ODOO_BROWSER_WAIT_SECONDS (default 60); a browser test that is
# still skipped because Chromium did not start fails the run instead of passing silently.
#
# Fails when the module is not discovered, is not installed afterwards, no test ran, any test failed, or a browser
# test was skipped because Chromium did not start.
set -euo pipefail

module="${1:-}"
if [[ ! "$module" =~ ^[a-z][a-z0-9_]{1,40}$ ]]; then
  echo "usage: ho-odoo-test <module> (lowercase letters, digits, underscores)" >&2
  exit 2
fi
workspace="${HO_ODOO_WORKSPACE:-/workspace}"
if [[ ! -f "$workspace/__manifest__.py" ]]; then
  echo "ho-odoo-test: $workspace has no __manifest__.py; the module must be at the repository root" >&2
  exit 2
fi
odoo_home="${HO_ODOO_HOME:-/opt/odoo}"
host="${HO_ODOO_DB_HOST:-postgres}"
user="${HO_ODOO_DB_USER:-odoo}"
export PGPASSWORD="${HO_ODOO_DB_PASSWORD:-odoo}"
database="ho_test_${module}_$(date +%s)_$RANDOM"

work="$(mktemp -d)"
cleanup() {
  dropdb --if-exists -h "$host" -U "$user" "$database" >/dev/null 2>&1 || true
  rm -rf "$work"
}
trap cleanup EXIT
mkdir "$work/addons"
ln -s "$workspace" "$work/addons/$module"

echo "ho-odoo-test: waiting for PostgreSQL at $host" >&2
for _ in $(seq 1 60); do
  pg_isready -q -h "$host" -U "$user" && break
  sleep 2
done
pg_isready -q -h "$host" -U "$user" || { echo "ho-odoo-test: PostgreSQL at $host is not reachable" >&2; exit 1; }

browser_wait="${HO_ODOO_BROWSER_WAIT_SECONDS:-60}"
[[ "$browser_wait" =~ ^[0-9]{1,3}$ && "$browser_wait" -ge 10 ]] \
  || { echo "ho-odoo-test: HO_ODOO_BROWSER_WAIT_SECONDS must be 10-999" >&2; exit 2; }

log="$work/odoo.log"
set +e
# odoo-bin is `odoo.cli.main()`; this runs the same entry point after raising the Chromium start wait, which
# odoo.tests.common reads when a browser test spawns Chromium (CHECK_BROWSER_SLEEP = 0.1 s per iteration).
"$odoo_home/venv/bin/python" -c '
import sys
sys.path.insert(0, sys.argv.pop(1))  # where odoo-bin lives, as when it runs as a script
wait = float(sys.argv.pop(1))
import odoo.cli
import odoo.tests.common as common
common.CHECK_BROWSER_ITERATIONS = int(wait / common.CHECK_BROWSER_SLEEP)
common.BROWSER_WAIT = common.CHECK_BROWSER_ITERATIONS * common.CHECK_BROWSER_SLEEP
sys.argv[0] = "odoo-bin"
odoo.cli.main()
' "$odoo_home" "$browser_wait" \
  --addons-path="$odoo_home/odoo/addons,$work/addons" \
  --data-dir="$work/data" \
  --db_host="$host" --db_user="$user" --db_password="$PGPASSWORD" \
  -d "$database" -i "$module" \
  --test-enable --test-tags="/$module" \
  --stop-after-init --http-port=0 --log-level=test 2>&1 | tee "$log"
status=${PIPESTATUS[0]}
set -e

fail() { echo "ho-odoo-test: FAILED: $*" >&2; exit 1; }
[[ $status -eq 0 ]] || fail "odoo exited with status $status"
grep -q "invalid module names, ignored: $module\|module $module: not installable\|Some modules are not loaded" "$log" \
  && fail "module $module was not discovered or could not be loaded"
state="$(psql -h "$host" -U "$user" -d "$database" -tAc "SELECT state FROM ir_module_module WHERE name = '$module'" 2>/dev/null || true)"
[[ "$state" == "installed" ]] || fail "module $module is '${state:-missing}' after the run, not installed"
grep -Eq "(ERROR|CRITICAL) .*odoo\.(modules|tests|addons)" "$log" && fail "errors were logged while installing or testing $module"
# Odoo turns a browser that never started into a skipped test; a skipped tour proves nothing, so the run fails.
grep -Eq "Failed to detect chrome devtools port|Chrome executable not found" "$log" \
  && fail "a browser test was skipped because Chromium did not start within ${browser_wait}s"
summary="$(grep -Eo "[0-9]+ failed, [0-9]+ error\(s\) of [0-9]+ tests" "$log" | tail -1 || true)"
[[ -n "$summary" ]] || fail "no test of $module ran"
[[ "$summary" =~ ^([0-9]+)\ failed,\ ([0-9]+)\ error\(s\)\ of\ ([0-9]+)\ tests$ ]] || fail "unreadable test summary: $summary"
[[ "${BASH_REMATCH[3]}" -gt 0 ]] || fail "no test of $module ran"
[[ "${BASH_REMATCH[1]}" -eq 0 && "${BASH_REMATCH[2]}" -eq 0 ]] || fail "$summary"
echo "ho-odoo-test: $module installed; $summary" >&2
