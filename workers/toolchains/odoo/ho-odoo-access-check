#!/usr/bin/env python3
"""Odoo-specific security checks of `ho-odoo-security` (docs/design/child-projects.md), on the module's source only.

- Every stored model a module defines (models.Model or models.TransientModel with its own `_name`) has at least one
  line in security/ir.model.access.csv: without one only the superuser can use it, and Odoo merely logs a warning.
- No HTTP route uses `auth="none"`, and no public route turns CSRF protection off. A justified route carries
  `# nosec` on its `@http.route(` line.

    ho-odoo-access-check [<module directory>]   (default /workspace)
"""

from __future__ import annotations

import ast
import csv
import sys
from pathlib import Path

STORED = {"Model", "TransientModel"}
SKIP = {".hermes", ".git", "tests", "migrations"}


def sources(root: Path):
    for path in sorted(root.rglob("*.py")):
        if not SKIP.intersection(path.relative_to(root).parts):
            yield path


def defined_models(tree: ast.AST) -> list[tuple[str, int]]:
    found = []
    for node in ast.walk(tree):
        if not isinstance(node, ast.ClassDef):
            continue
        bases = {b.attr if isinstance(b, ast.Attribute) else getattr(b, "id", None) for b in node.bases}
        if not bases & STORED:
            continue
        for item in node.body:
            if (isinstance(item, ast.Assign) and any(isinstance(t, ast.Name) and t.id == "_name" for t in item.targets)
                    and isinstance(item.value, ast.Constant) and isinstance(item.value.value, str)):
                found.append((item.value.value, item.lineno))
    return found


def risky_routes(tree: ast.AST, lines: list[str]) -> list[tuple[int, str]]:
    found = []
    for node in ast.walk(tree):
        if not isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
            continue
        for decorator in node.decorator_list:
            if not (isinstance(decorator, ast.Call) and getattr(decorator.func, "attr", None) == "route"):
                continue
            if "# nosec" in lines[decorator.lineno - 1]:
                continue
            options = {k.arg: k.value.value for k in decorator.keywords if isinstance(k.value, ast.Constant)}
            if options.get("auth") == "none":
                found.append((decorator.lineno, f'{node.name}: auth="none" runs without any user or database'))
            elif options.get("csrf") is False and options.get("auth") == "public":
                found.append((decorator.lineno, f"{node.name}: a public route with csrf=False"))
    return found


def main() -> int:
    root = Path(sys.argv[1] if len(sys.argv) > 1 else "/workspace")
    access = root / "security" / "ir.model.access.csv"
    covered: set[str] = set()
    if access.is_file():
        with access.open(newline="", encoding="utf-8") as handle:
            covered = {row.get("model_id:id", "").split(".")[-1] for row in csv.DictReader(handle)}
    problems = []
    for path in sources(root):
        text = path.read_text(encoding="utf-8")
        tree = ast.parse(text, filename=str(path))
        relative = path.relative_to(root)
        for name, line in defined_models(tree):
            if "model_" + name.replace(".", "_") not in covered:
                problems.append(f"{relative}:{line}: model {name} has no line in security/ir.model.access.csv")
        for line, detail in risky_routes(tree, text.splitlines()):
            problems.append(f"{relative}:{line}: {detail}")
    for problem in problems:
        print(problem)
    return 1 if problems else 0


if __name__ == "__main__":
    sys.exit(main())
