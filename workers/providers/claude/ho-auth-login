#!/bin/bash
# Interactive subscription login with profile access, used by executions and account-only /usage probes.
# Only this identity's credential volume is mounted; CLI state and browser-flow data stay in tmpfs.
set -euo pipefail
dest=/run/ho-credentials/claude
mkdir -p "$CLAUDE_CONFIG_DIR"
unset CLAUDE_CODE_OAUTH_TOKEN

echo "Authorize your Claude subscription in the browser. This also enables automatic quota readings."
claude auth login --claudeai
claude auth status --json > /tmp/ho-auth-status.json
/opt/ho/pen-node/bin/node -e '
  const fs = require("fs");
  try {
    const status = JSON.parse(fs.readFileSync("/tmp/ho-auth-status.json"));
    const cred = JSON.parse(fs.readFileSync(process.env.CLAUDE_CONFIG_DIR + "/.credentials.json"));
    if (status.loggedIn !== true || !cred.claudeAiOauth?.accessToken ||
        !cred.claudeAiOauth?.scopes?.includes("user:profile")) process.exit(1);
  } catch { process.exit(1); }
' || { echo "The login lacks subscription profile access; nothing was saved. Sign in again." >&2; exit 4; }
(
  flock -w 30 9 || exit 1
  install -m 600 "$CLAUDE_CONFIG_DIR/.credentials.json" "$dest/.credentials.json.new.$$"
  mv -f "$dest/.credentials.json.new.$$" "$dest/.credentials.json"
  rm -f "$dest/oauth_token"
) 9>"$dest/.lock"
echo "Subscription login saved. Verification used account status, with no model request."
