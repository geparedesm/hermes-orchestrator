# Pinned versions for execution images (MASTER_SPEC sections 18-19). Read by scripts/build-images.sh.
# Changing a version is an update: rebuild, run `make test-docker`, then `make images` to promote.

# Official CLIs, installed from their official npm packages.
CLAUDE_CODE_VERSION=2.1.280
CODEX_VERSION=0.159.2

# Node.js runtime used by the Codex npm launcher and by the node toolchain.
NODE_IMAGE=node:22-bookworm-slim@sha256:43ac6c60b8f89723f746e8a92ce91abd5017e627ce1ddfe4238355d3a30b772c

# Flutter stable release (tag and commit from the official releases manifest).
FLUTTER_VERSION=3.47.5
FLUTTER_COMMIT=6a19cca56475dbfba1478ee68d7bd0c2ef891da1
