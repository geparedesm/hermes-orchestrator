#!/bin/bash
# Run the execution command once Agent Manager has delivered the granted secret
# files into /run/ho/secrets (SECURITY_MODEL.md section 7.3).
set -euo pipefail
for _ in $(seq 1 300); do
  if [[ -e /run/ho/secrets/.ready ]]; then
    exec "$@"
  fi
  sleep 0.1
done
echo "ho: secrets were not delivered in time" >&2
exit 125
